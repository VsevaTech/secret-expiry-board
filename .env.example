# Copy to .env - never commit .env
# Telegram bot token from @BotFather and the chat/channel/group id that should receive reminders.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Reminder thresholds in days before expiry (a reminder is sent once per threshold).
REMINDER_DAYS=30,14,7,1
# How often the background job runs.
CHECK_INTERVAL_MINUTES=60
SCHEDULER_ENABLED=true
TLS_TIMEOUT_SECONDS=10

# SQLite file (inside the container /data is a volume in docker-compose).
DATABASE_URL=sqlite:///./data/secret_expiry_board.db
# Optional: public URL of the board, appended to Telegram messages.
APP_BASE_URL=
